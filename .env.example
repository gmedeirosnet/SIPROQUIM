# Environment Variables Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=db
DB_NAME=estoque
DB_USER=admin
DB_PASSWORD=your_secure_password_here
DB_PORT=5432

# Application Configuration
# Uncomment and set if needed for future use
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://siproquim.gmedeiros.net

# SSL Configuration (used by run.sh)
# SSL_MODE=production  # Options: staging, production, none
# SSL_EMAIL=admin@gmedeiros.net
# SSL_DOMAIN=siproquim.gmedeiros.net

# SonarQube Configuration (for local development)
# SONAR_HOST_URL=https://sonarcloud.io
# SONAR_TOKEN=your_sonarcloud_token_here
# SONAR_PROJECT_KEY=SIPROQUIM
# SONAR_ORGANIZATION=gmedeirosnet
